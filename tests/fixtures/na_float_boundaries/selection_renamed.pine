//@version=6
strategy("Typed missing selection", currency=currency.USDT, initial_capital=1000000000, default_qty_type=strategy.fixed)
phase = input.int(0, "phase", options=[0, 1, 2])
channel = input.int(0, "channel", options=[0, 1])
int n = bar_index
float renamedArray = na
renamedArray := if bar_index % 3 == 0
    n[1]
else
    na
float renamedFlag = na
renamedFlag := if bar_index % 3 != 0
    na
else
    n[1]
value = channel == 0 ? renamedArray : renamedFlag
encoded = na(value) ? 1.0 : 2.0 + value / 1000.0
if bar_index <= 1437 and bar_index % 3 == phase
    strategy.entry("sample", strategy.long, qty=encoded)
else if strategy.position_size != 0
    strategy.close_all()
plot(renamedArray[1] + renamedFlag[1])
auditHistory0 = na(renamedArray[0]) ? 1.0 : 2.0 + float(renamedArray[0]) / 1000.0
auditHistory1 = na(renamedArray[1]) ? 1.0 : 2.0 + float(renamedArray[1]) / 1000.0
auditHistory2 = na(renamedArray[2]) ? 1.0 : 2.0 + float(renamedArray[2]) / 1000.0
auditother = na(renamedFlag) ? 1.0 : 2.0 + renamedFlag / 1000.0
// @pf-trace current=encoded
// @pf-trace history0=auditHistory0
// @pf-trace history1=auditHistory1
// @pf-trace history2=auditHistory2
// @pf-trace other=auditother
