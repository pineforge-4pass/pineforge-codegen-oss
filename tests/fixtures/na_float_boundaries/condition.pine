//@version=6
strategy("Integer history in a condition", currency=currency.USDT, initial_capital=1000000000, default_qty_type=strategy.fixed)
int n = bar_index
float lag = na
lag := n[1]
if bar_index <= 1437 and bar_index % 3 == 0 and lag < 5
    strategy.entry("sample", strategy.long, qty=1.0)
else if strategy.position_size != 0
    strategy.close_all()
plot(lag)
