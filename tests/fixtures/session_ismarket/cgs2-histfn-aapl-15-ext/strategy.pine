// CG-SESSION-2: how does TradingView keep a session.* flag's history inside a
// user function? process_orders_on_close=true: every bar reverses the position
// at its own close, so every trade's ENTRY is one chart bar (TradingView dates a
// process_orders_on_close fill at the bar's open) and the entry's Signal (its
// comment) carries the seven flags on the bar ("C", order M P Q F L f l) and one
// bit per read: "A" post1() = session.ispostmarket[1] called on every bar, "B"
// the same function called on odd bars only (a second call site), "Z" a
// function whose [1] read sits on the lazy side of an "and" reached on even
// bars, called on every bar, "K" a function whose [1] read sits in a block run
// on every third bar, called on every bar, "N" and "O" newSession() =
// session.ismarket and not session.ismarket[1] at two call sites.
//@version=6
strategy("CG-SESSION-2 session history in functions", overlay=true, initial_capital=1000000000,
     default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=1,
     commission_type=strategy.commission.percent, commission_value=0, slippage=0,
     process_orders_on_close=true, margin_long=100, margin_short=100)

bit(bool x) => x ? "1" : "0"
post1() => session.ispostmarket[1]
lazyf() => bar_index % 2 == 0 and session.ispostmarket[1]
blockf() =>
    r = false
    if bar_index % 3 == 0
        r := session.ispremarket[1]
    r
newSession() => session.ismarket and not session.ismarket[1]
a = post1()
b = bar_index % 2 == 1 ? post1() : false
z = lazyf()
k = blockf()
n = newSession()
o = newSession()
flag = "C" + bit(session.ismarket) + bit(session.ispremarket) + bit(session.ispostmarket)
     + bit(session.isfirstbar) + bit(session.islastbar)
     + bit(session.isfirstbar_regular) + bit(session.islastbar_regular)
     + "A" + bit(a) + "B" + bit(b) + "Z" + bit(z) + "K" + bit(k) + "N" + bit(n) + "O" + bit(o)
if bar_index % 2 == 0
    strategy.entry("L", strategy.long, comment=flag)
else
    strategy.entry("S", strategy.short, comment=flag)
