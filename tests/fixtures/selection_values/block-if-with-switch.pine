//@version=6
strategy("Block if containing switch", currency = currency.NONE, initial_capital = 1000000)
// Derived: n%3!=0 yields 4; otherwise odd n yields 3; even n selects 1 for n%5=0, else 2.
n = bar_index
value = switch n % 3
    0 =>
        if n % 2 == 0
            switch n % 5
                0 => 1.0
                => 2.0
        else
            3.0
    => 4.0
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
