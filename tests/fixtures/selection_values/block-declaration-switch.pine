//@version=6
strategy("Block local switch declaration", currency = currency.NONE, initial_capital = 1000000)
// Derived: the local declaration owns a switch RHS; its following read supplies the arm value.
value = switch bar_index % 3
    0 =>
        chosen = switch bar_index % 2
            0 => 1.0
            => 2.0
        chosen
    => 3.0
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
