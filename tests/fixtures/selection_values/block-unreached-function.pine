//@version=6
strategy("Unreached block compound arm", currency = currency.NONE, initial_capital = 1000000)
// Derived: the callable's structured body is valid independently of its unreachable call.
choose(int n) =>
    switch n
        0 =>
            switch n
                0 => 1.0
                => 2.0
        => 3.0
value = bar_index < 0 ? choose(bar_index) : 4.0
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
