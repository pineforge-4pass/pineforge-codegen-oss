//@version=6
strategy("Delimited switch operand", currency = currency.NONE, initial_capital = 1000000)
// Derived: parentheses suppress block indentation tokens, so parsing fails before the placeholder.
value = math.abs(switch bar_index % 2
    0 => 1.0
    => 2.0
)
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
