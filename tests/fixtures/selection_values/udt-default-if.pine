//@version=6
strategy("If field default", currency = currency.NONE, initial_capital = 1000000)
// Derived: a field default IfStmt reaches the same omitted-constructor-argument rendering path.
type Sample
    float value = if true
        1.0
    else
        2.0
sample = Sample.new()
plot(sample.value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
