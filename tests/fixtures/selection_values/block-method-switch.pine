//@version=6
strategy("Method block compound arm", currency = currency.NONE, initial_capital = 1000000)
// Derived: bare nested switch assigns the method return slot with the same 1/2/3 selection.
method choose(int n) =>
    switch n % 3
        0 =>
            switch n % 2
                0 => 1.0
                => 2.0
        => 3.0
n = bar_index
value = n.choose()
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
