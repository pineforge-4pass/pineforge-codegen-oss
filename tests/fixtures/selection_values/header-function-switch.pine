//@version=6
strategy("Function header switch", currency = currency.NONE, initial_capital = 1000000)
// Derived: the function-arrow parser keeps a bare SwitchStmt; n even yields 1, odd yields 2.
choose(int n) => switch n % 2
    0 => 1.0
    => 2.0
value = choose(bar_index)
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
