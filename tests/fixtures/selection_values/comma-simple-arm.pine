//@version=6
strategy("Comma simple arm", currency = currency.NONE, initial_capital = 1000000)
// Derived: simple inline declarations and arithmetic tails yield 1/2 without a control wrapper.
value = switch bar_index % 2
    0 => x = 4.0, x - 3.0
    => y = 6.0, y / 3.0
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
