//@version=6
strategy("Requested timeframe selector switch block arm", currency = currency.NONE, initial_capital = 1000000)
// Block arm computes a local from an input-derived number, then yields the timeframe string.
pick_n = input.int(1, "Pick", minval = 1, maxval = 2)
mult_n = input.int(4, "Multiplier", minval = 1)
tf = switch pick_n
    1 =>
        base_min = mult_n * 15
        str.tostring(base_min)
    =>
        timeframe.period
value = request.security(syminfo.tickerid, tf, close)
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
