//@version=6
strategy("Ternary if operand", currency = currency.NONE, initial_capital = 1000000)
// Derived: an IfStmt false operand also falls through scalar expression dispatch.
value = bar_index % 3 == 0 ? 3.0 : if bar_index % 2 == 0
    1.0
else
    2.0
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
