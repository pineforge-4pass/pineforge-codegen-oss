//@version=6
strategy("Block default switch", currency = currency.NONE, initial_capital = 1000000)
// Derived: n%3=0/1 yields 1/2; default recursively selects 3 for even n, 4 for odd n.
n = bar_index
value = switch n % 3
    0 => 1.0
    1 => 2.0
    =>
        switch n % 2
            0 => 3.0
            => 4.0
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
