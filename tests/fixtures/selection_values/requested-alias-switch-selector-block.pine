//@version=6
strategy("Requested alias selector switch block arm", currency = currency.NONE, initial_capital = 1000000)
// Block arm declares two locals, uses the first in the second, yields the requested value.
pick_n = input.int(1, "Pick", minval = 1, maxval = 2)
chosen = switch pick_n
    1 =>
        span_v = high - low
        mid_v = low + span_v / 2
        mid_v
    =>
        close
value = request.security(syminfo.tickerid, timeframe.period, chosen)
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
