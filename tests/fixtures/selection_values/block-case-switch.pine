//@version=6
strategy("Block case switch", currency = currency.NONE, initial_capital = 1000000)
// Derived: a bare nested SwitchStmt assigns the target recursively: 1/2 when n%3=0, else 3.
n = bar_index
value = switch n % 3
    0 =>
        switch n % 2
            0 => 1.0
            => 2.0
    => 3.0
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
