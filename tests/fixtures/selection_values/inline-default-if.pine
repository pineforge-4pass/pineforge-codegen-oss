//@version=6
strategy("Inline default if", currency = currency.NONE, initial_capital = 1000000)
// Derived: default-block value emission also sends a wrapped IfStmt to scalar dispatch.
value = switch bar_index % 3
    0 => 1.0
    => if bar_index % 2 == 0
        2.0
    else
        3.0
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
