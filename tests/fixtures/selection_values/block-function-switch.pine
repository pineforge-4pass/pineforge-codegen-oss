//@version=6
strategy("Function block switch", currency = currency.NONE, initial_capital = 1000000)
// Derived: a callable's bare switch tail writes its return slot through recursive selection.
choose(int n) =>
    switch n % 3
        0 =>
            switch n % 2
                0 => 1.0
                => 2.0
        => 3.0
value = choose(bar_index)
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
