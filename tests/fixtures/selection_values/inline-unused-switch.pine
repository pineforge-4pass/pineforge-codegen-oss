//@version=6
strategy("Inline unused switch", currency = currency.NONE, initial_capital = 1000000)
// Derived: statement emission drops a scalar result starting with a comment, hiding the gap.
var values = array.new_float()
switch bar_index % 3
    0 => switch bar_index % 2
        0 => array.push(values, 1.0)
        => array.push(values, 2.0)
    => array.push(values, 3.0)
plot(array.size(values), "count")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
