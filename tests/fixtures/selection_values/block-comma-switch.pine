//@version=6
strategy("Block declaration then switch", currency = currency.NONE, initial_capital = 1000000)
// Derived: ordered local declaration then bare switch selects 1/2 for residue zero, else 3.
value = switch bar_index % 3
    0 =>
        n = bar_index % 2
        switch n
            0 => 1.0
            => 2.0
    => 3.0
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
