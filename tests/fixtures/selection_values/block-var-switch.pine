//@version=6
strategy("Persistent block switch", currency = currency.NONE, initial_capital = 1000000)
// Derived: the once latch runs at bar zero, selects 1, and retains it on later bars.
var float value = switch bar_index % 3
    0 =>
        switch bar_index % 2
            0 => 1.0
            => 2.0
    => 3.0
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
