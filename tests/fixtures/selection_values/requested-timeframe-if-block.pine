//@version=6
strategy("Requested timeframe if block arm", currency = currency.NONE, initial_capital = 1000000)
// Block arm (two statements) in the if that selects the request timeframe.
pick = input.bool(true, "Choose chart")
tf = if pick
    base_tf = timeframe.period
    base_tf
else
    alt_tf = "1D"
    alt_tf
value = request.security(syminfo.tickerid, tf, close)
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
