//@version=6
strategy("Nested switch without default", currency = currency.NONE, initial_capital = 1000000)
// Derived: n%3=0 takes the inner switch, which yields 1 only for even n, otherwise na.
value = switch bar_index % 3
    0 =>
        switch bar_index % 2
            0 => 1.0
    => 3.0
plot(value, "selected")
plot(na(value) ? 1 : 0, "missing")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
