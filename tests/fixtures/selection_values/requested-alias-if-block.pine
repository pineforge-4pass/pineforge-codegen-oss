//@version=6
strategy("Requested alias if block arm", currency = currency.NONE, initial_capital = 1000000)
// Block arm (two statements) in the if whose value is the requested expression.
chosen = if close >= open
    hi = high
    hi
else
    lo = low
    lo
value = request.security(syminfo.tickerid, timeframe.period, chosen)
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
