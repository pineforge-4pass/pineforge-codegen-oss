//@version=6
strategy("Inline reassignment from switch", currency = currency.NONE, initial_capital = 1000000)
// Boundary probe: assignment dispatch owns its switch RHS; this is not ExprStmt(SwitchStmt).
value = 0.0
switch bar_index % 3
    0 => value := switch bar_index % 2
        0 => 1.0
        => 2.0
    => value := 3.0
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
