//@version=6
strategy("Requested timeframe switch", currency = currency.NONE, initial_capital = 1000000)
// Derived: registration explicitly renders a pure switch selecting direct input strings.
pick = input.bool(true, "Choose chart")
tf = switch pick
    true => timeframe.period
    => "1D"
value = request.security(syminfo.tickerid, tf, close)
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
