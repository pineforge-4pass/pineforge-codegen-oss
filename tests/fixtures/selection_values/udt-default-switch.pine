//@version=6
strategy("Switch field default", currency = currency.NONE, initial_capital = 1000000)
// Derived: TypeDecl visits its default, then omitted new() arguments render that default as scalar.
type Sample
    float value = switch 0
        0 => 1.0
        => 2.0
sample = Sample.new()
plot(sample.value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
