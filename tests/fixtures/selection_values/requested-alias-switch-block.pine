//@version=6
strategy("Requested alias switch block arm", currency = currency.NONE, initial_capital = 1000000)
// Block arm (two statements) in the switch whose value is the requested expression.
chosen = switch
    close >= open =>
        hi = high
        hi
    =>
        lo = low
        lo
value = request.security(syminfo.tickerid, timeframe.period, chosen)
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
