//@version=6
strategy("Typed nested block values", currency = currency.NONE, initial_capital = 1000000)
// Derived: compatible bool and string branches retain their types through nested block selection.
truth = switch bar_index % 3
    0 =>
        switch bar_index % 2
            0 => true
            => false
    => false
text = switch bar_index % 3
    0 =>
        switch bar_index % 2
            0 => "one"
            => "two"
    => "three"
plot(truth ? 1 : 0, "truth")
plot(str.length(text), "length")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
