//@version=6
strategy("Inline if containing switch", currency = currency.NONE, initial_capital = 1000000)
// Derived: the outer wrapped if fails before its correctly indented inner switch is emitted.
value = switch bar_index % 3
    0 => if bar_index % 2 == 0
        switch bar_index % 5
            0 => 1.0
            => 2.0
    else
        3.0
    => 4.0
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
