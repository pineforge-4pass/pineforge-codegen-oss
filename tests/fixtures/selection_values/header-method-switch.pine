//@version=6
strategy("Method header switch", currency = currency.NONE, initial_capital = 1000000)
// Derived: method-arrow parsing also preserves the bare switch; even/odd yields 1/2.
method choose(int n) => switch n % 2
    0 => 1.0
    => 2.0
n = bar_index
value = n.choose()
plot(value, "selected")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
