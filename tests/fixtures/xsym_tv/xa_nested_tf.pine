//@version=6
// request.security reached through nested helpers: the symbol and the
// timeframe are helper parameters two and three levels down. Each exit
// comment spells what every call read on the bar the close was sent.
strategy("PF xa nested tf", overlay = true)
tfA = input.timeframe("60", "A")
tfB = input.timeframe("240", "B")
g(sym, tf) => request.security(sym, tf, ta.sma(close, 3))
h(sym, tf) => g(sym, tf)
k(tf) => h(syminfo.tickerid, tf)
a = h(syminfo.tickerid, tfA)
b = h(syminfo.tickerid, tfB)
c = k("60")
d = k(tfB)
e = h(ticker.heikinashi(syminfo.tickerid), tfA)
s(x) => na(x) ? "na" : str.tostring(x)
m = minute(time, "UTC")
if m == 0 or m == 30
    strategy.entry("L", strategy.long)
if m == 15 or m == 45
    strategy.close("L", comment = s(a) + "|" + s(b) + "|" + s(c) + "|" + s(d) + "|" + s(e))
