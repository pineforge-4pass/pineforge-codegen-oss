//@version=6
strategy("Requested hour selected by parity", currency = currency.USDT, initial_capital = 1000000)
pf_tf = if bar_index % 2 == 0
    "60"
else
    "240"
pf_req = request.security(syminfo.tickerid, pf_tf, hour)
if bar_index > 6 and bar_index % 3 == 0
    strategy.entry("pf_long", strategy.long, qty = 1 + pf_req / 100)
if bar_index > 6 and bar_index % 3 == 1
    strategy.close("pf_long")
