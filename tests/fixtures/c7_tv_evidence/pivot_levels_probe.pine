//@version=6
strategy("C7 pivot formula probe", overlay=false, initial_capital=1000000000000, pyramiding=100, default_qty_type=strategy.fixed)
// One shared completed period keeps every type on the same HLC tape. The
// first anchor at bar 20 closes bars 0..19; the next is delayed until bar 140
// so all level markers observe that same held period.
anchor = bar_index % 120 == 20
var float periodOpen = na
var float periodHigh = na
var float periodLow = na
var float periodClose = na
var float closedOpen = na
var float closedHigh = na
var float closedLow = na
var float closedClose = na
if anchor
    closedOpen := periodOpen
    closedHigh := periodHigh
    closedLow := periodLow
    closedClose := periodClose
    periodOpen := open
    periodHigh := high
    periodLow := low
    periodClose := close
else
    periodOpen := na(periodOpen) ? open : periodOpen
    periodHigh := na(periodHigh) ? high : math.max(periodHigh, high)
    periodLow := na(periodLow) ? low : math.min(periodLow, low)
    periodClose := close
lv0 = ta.pivot_point_levels("Traditional", anchor)
lv1 = ta.pivot_point_levels("Fibonacci", anchor)
lv2 = ta.pivot_point_levels("Woodie", anchor)
lv3 = ta.pivot_point_levels("Classic", anchor)
lv4 = ta.pivot_point_levels("DM", anchor)
lv5 = ta.pivot_point_levels("Camarilla", anchor)
if bar_index == 21 and not na(closedOpen)
    strategy.order("Period-O", closedOpen >= 0 ? strategy.long : strategy.short, qty=100000 + math.abs(closedOpen))
if bar_index == 22 and not na(closedHigh)
    strategy.order("Period-H", closedHigh >= 0 ? strategy.long : strategy.short, qty=100000 + math.abs(closedHigh))
if bar_index == 23 and not na(closedLow)
    strategy.order("Period-L", closedLow >= 0 ? strategy.long : strategy.short, qty=100000 + math.abs(closedLow))
if bar_index == 24 and not na(closedClose)
    strategy.order("Period-C", closedClose >= 0 ? strategy.long : strategy.short, qty=100000 + math.abs(closedClose))
if bar_index == 20
    strategy.order("Anchor-O", open >= 0 ? strategy.long : strategy.short, qty=100000 + math.abs(open))
v0_0 = array.get(lv0, 0)
if bar_index == 25 and not na(v0_0)
    strategy.order("Traditional-L0", v0_0 >= 0 ? strategy.long : strategy.short, qty=100000 + math.abs(v0_0))
v0_1 = array.get(lv0, 1)
if bar_index == 26 and not na(v0_1)
    strategy.order("Traditional-L1", v0_1 >= 0 ? strategy.long : strategy.short, qty=100000 + math.abs(v0_1))
