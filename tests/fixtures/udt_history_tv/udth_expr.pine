//@version=6
// CG-UDT-HIST: the history of an expression whose value is a user-defined
// object: a field holding an object, reassigned every bar on a var object; a
// function's result; a ternary selecting one of two objects. Each close's
// comment spells the values the script reads on that bar.
strategy("UDTH expr", overlay = true, default_qty_type = strategy.fixed, default_qty_value = 1)
type Cell
    int v
type Outer
    Cell inner
mk(int k) =>
    Cell.new(v = k)
var o = Outer.new(Cell.new(v = -5))
o.inner := Cell.new(v = bar_index)
a = Cell.new(v = bar_index * 2)
b = Cell.new(v = bar_index * 3)
f1 = na(o.inner[1]) ? -1 : (o.inner[1]).v
c1 = na(mk(bar_index * 5)[1]) ? -1 : (mk(bar_index * 7)[1]).v
t1 = na((bar_index % 2 == 0 ? a : b)[1]) ? -1 : ((bar_index % 2 == 0 ? a : b)[1]).v
mn = minute(time, "UTC")
if mn == 0 or mn == 30
    strategy.entry("L", strategy.long)
if mn == 15 or mn == 45
    strategy.close("L", comment = str.tostring(f1) + "|" + str.tostring(c1) + "|" + str.tostring(t1))
