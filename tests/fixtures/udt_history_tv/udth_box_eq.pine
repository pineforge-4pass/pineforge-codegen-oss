//@version=6
// CG-UDT-HIST: do == and != compare drawing references, and against history?
// Each close's comment spells the comparisons read on that bar.
strategy("UDTH box eq", overlay = true, default_qty_type = strategy.fixed, default_qty_value = 1, max_boxes_count = 500)
b = box.new(bar_index, high, bar_index + 1, low)
var box vb = box.new(bar_index, close, bar_index + 1, close)
s1 = b != b[1]
s2 = vb == vb[1]
mn = minute(time, "UTC")
if mn == 0 or mn == 30
    strategy.entry("L", strategy.long)
if mn == 15 or mn == 45
    strategy.close("L", comment = str.tostring(s1) + "|" + str.tostring(s2))
