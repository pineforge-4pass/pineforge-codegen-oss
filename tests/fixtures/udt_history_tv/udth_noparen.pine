//@version=6
// CG-UDT-HIST: is `c[1].v` (no parentheses) accepted, and what does it read?
// Each close's comment spells the value the script reads on that bar.
strategy("UDTH noparen", overlay = true, default_qty_type = strategy.fixed, default_qty_value = 1)
type Cell
    float v
c = Cell.new(v = bar_index)
float prevV = -1.0
if bar_index > 0
    prevV := c[1].v
mn = minute(time, "UTC")
if mn == 0 or mn == 30
    strategy.entry("L", strategy.long)
if mn == 15 or mn == 45
    strategy.close("L", comment = str.tostring(prevV))
