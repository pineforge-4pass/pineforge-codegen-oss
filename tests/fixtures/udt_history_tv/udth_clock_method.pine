//@version=6
// CG-UDT-HIST: the clock of a method receiver's history at a call site that
// runs on every third bar: this[2] read two calls back or at the call two bars
// back. Each close's comment spells the value the script reads on that bar.
strategy("UDTH clock method", overlay = true, default_qty_type = strategy.fixed, default_qty_value = 1)
type Cell
    int v
method r2(Cell this) =>
    na(this[2]) ? -1 : (this[2]).v
int d = -2
if bar_index % 3 == 1
    d := Cell.new(v = bar_index).r2()
mn = minute(time, "UTC")
if mn == 0 or mn == 30
    strategy.entry("L", strategy.long)
if mn == 15 or mn == 45
    strategy.close("L", comment = str.tostring(d))
