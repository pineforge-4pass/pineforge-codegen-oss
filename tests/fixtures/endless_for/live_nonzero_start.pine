//@version=6
strategy("Descending loop end bound is the counter, iteration count in the quantity", initial_capital = 1000000, currency = currency.NONE)
float acc = 0.0
for i = 5 to i
    acc := acc + 1
// quantity: 1 + the number of iterations when it is at most 20, otherwise 21 + the number of powers of ten from 1e3 up to 1e8 that the count reaches
float shown = acc <= 20 ? acc : 20 + (acc >= 1e3 ? 1 : 0) + (acc >= 1e4 ? 1 : 0) + (acc >= 1e5 ? 1 : 0) + (acc >= 1e6 ? 1 : 0) + (acc >= 1e7 ? 1 : 0) + (acc >= 1e8 ? 1 : 0)
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = shown + 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
