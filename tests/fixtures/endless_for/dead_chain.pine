//@version=6
strategy("Endless loop whose result is read only by another unused variable", initial_capital = 1000000, currency = currency.NONE)
float acc = 0.0
for i = 0 to i
    acc := acc + 1
float chained = acc + 1
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("M", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close_all()
