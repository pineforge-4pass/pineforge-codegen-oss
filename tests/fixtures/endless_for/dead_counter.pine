//@version=6
strategy("Loop end bound is the counter, no break", initial_capital = 1000000, currency = currency.NONE)
float acc = 0.0
for i = 0 to i
    acc := acc + 1
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
