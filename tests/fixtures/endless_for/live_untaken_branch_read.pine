//@version=6
strategy("Endless loop whose result is used only in a branch never taken", initial_capital = 1000000, currency = currency.NONE)
float acc = 0.0
for i = 0 to i
    acc := acc + 1
if bar_index < 0
    strategy.entry("N", strategy.long, qty = 2 + acc * 0)
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("M", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close_all()
