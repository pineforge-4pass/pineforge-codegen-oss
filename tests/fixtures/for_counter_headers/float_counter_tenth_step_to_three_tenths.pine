//@version=6
strategy("Inexact float step to three tenths", initial_capital = 1000000, currency = currency.NONE)
float acc = 0.0
for x = 0.0 to 0.3 by 0.1
    acc += 1
// TradingView measurement: quantity 4, including the rounded last step.
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = acc)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
