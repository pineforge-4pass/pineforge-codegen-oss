//@version=6
strategy("Counter in the step with a non-zero start", initial_capital = 1000000, currency = currency.NONE)
float acc = 0.0
for i = 2 to 6 by (i == 2 ? 1 : 2)
    acc := acc + i + 1
// 25 if the step is read once with the counter at its start value 2 (step 1: 2,3,4,5,6); 15 if it is read with 0 or na (step 2: 2,4,6)
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = acc)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
