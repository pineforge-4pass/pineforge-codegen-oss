//@version=6
strategy("value probe: counter value used as a quantity", initial_capital = 1000000, currency = currency.NONE)
// 9 / 2 is 4.5; the loop runs once (4.5 to 5): the counter value itself is the quantity: 4.5 as a float counter, 4 as a truncated int counter.
float last = 0.0
for i = 9 / 2 to 5
    last := i
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = last)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
