//@version=6
strategy("value probe: division start, no step", initial_capital = 1000000, currency = currency.NONE)
// 5 / 2 is 2.5. A float counter visits 2.5, 3.5, 4.5, 5.5: sum 16. An int counter that truncates the start visits 2..6: sum 20.
float acc = 0.0
for i = 5 / 2 to 6
    acc := acc + i
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1 + acc / 100)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
