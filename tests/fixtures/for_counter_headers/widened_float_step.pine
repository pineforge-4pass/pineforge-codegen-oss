//@version=6
strategy("carrier probe widened_float_step", initial_capital = 1000000, currency = currency.NONE)
n = input.int(5, "Numerator")
s = n
s := s / 2
float acc = 0.0
for i = s to 6 by 0.5
    acc := acc + 1
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1 + acc / 100)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
