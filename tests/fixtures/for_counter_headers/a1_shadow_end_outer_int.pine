//@version=6
strategy("Counter shadows an outer variable in the end bound", initial_capital = 1000000, currency = currency.NONE)
int i = 0
float acc = 0.0
for i = 0 to (i == 0 ? 3 : 1)
    acc := acc + i + 1
// 3 if the end bound reads the loop counter (as in the plain counter probe); 10 if it reads the outer variable i, which stays 0
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = acc)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
