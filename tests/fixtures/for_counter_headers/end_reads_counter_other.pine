//@version=6
strategy("Counter in own end expression second value", initial_capital = 1000000, currency = currency.NONE)
float acc = 0.0
for i = 0 to (i == 0 ? 3 : 1)
    acc := acc + i + 1
// acc is 10 if the end expression is read once with i at its start value, 3 if it is read again after each step
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = acc)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
