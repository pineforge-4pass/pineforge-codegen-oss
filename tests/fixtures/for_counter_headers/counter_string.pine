//@version=6
strategy("synthetic fractional counter string", currency=currency.NONE, initial_capital=1000000000000, pyramiding=4)
n = input.int(5, "Numerator")
for i = n / 2 to n / 2 + 2
    if bar_index > 6 and bar_index % 7 == 3
        strategy.entry("i=" + str.tostring(i, "0.000000000000000000"), strategy.long, qty=1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close_all()
