//@version=6
strategy("value probe: division only in the end", initial_capital = 1000000, currency = currency.NONE)
// the end 7 / 2 is 3.5; the counter starts at an int 0 and visits 0, 1, 2, 3: sum 6.
float acc = 0.0
for i = 0 to 7 / 2
    acc := acc + i
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1 + acc / 100)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
