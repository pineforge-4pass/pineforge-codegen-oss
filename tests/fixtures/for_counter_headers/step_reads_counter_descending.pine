//@version=6
strategy("Counter in own step expression counting down", initial_capital = 1000000, currency = currency.NONE)
float acc = 0.0
for i = 5 to 0 by (i > 3 ? -1 : -2)
    acc := acc + i + 1
// TradingView stops on bar 0 with RE10021 before this value is observed.
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = acc)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
