//@version=6
strategy("Loop end bound reading a variable the body changes", initial_capital = 1000000, currency = currency.NONE)
float limit = 3.0
float acc = 0.0
for i = 0 to limit
    limit := limit - 1.0
    acc := acc + 1.0
// acc is 4 if the end bound is read once before the loop, 2 if it is read again before every iteration
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = acc)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
