//@version=6
strategy("carrier probe reassign_plain_qty", initial_capital = 1000000000000, currency = currency.NONE)
n = input.int(5, "Numerator")
s = n
s := s / 2
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = s)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
