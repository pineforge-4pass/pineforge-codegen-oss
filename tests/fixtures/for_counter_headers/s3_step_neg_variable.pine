//@version=6
strategy("Loop negative variable step", initial_capital = 1000000, currency = currency.NONE)
int stride = -1
float acc = 0.0
for i = 5 to 1 by stride
    acc := acc + i
// 15 if the loop counts down 5, 4, 3, 2, 1; no trades if TradingView stops the run
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = acc)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
