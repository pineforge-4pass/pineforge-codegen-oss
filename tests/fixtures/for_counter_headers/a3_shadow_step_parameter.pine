//@version=6
strategy("Counter shadows a function parameter in the step", initial_capital = 1000000, currency = currency.NONE)
total(int i) =>
    float acc = 0.0
    for i = 0 to 4 by (i == 0 ? 1 : 2)
        acc := acc + i + 1
    acc
tradeQty = total(7)
// 15 if the step reads the loop counter at its start value 0; 9 if it reads the parameter i, which is 7
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = tradeQty)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
