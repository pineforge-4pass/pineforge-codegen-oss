//@version=6
strategy("synthetic fractional descending counter", currency=currency.NONE, initial_capital=1000000000000)
n = input.int(5, "Numerator")
float pf_sum = 0
for i = n / 2 to 0
    pf_sum += i
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty=pf_sum)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
