//@version=6
strategy("value probe: division start, int step", initial_capital = 1000000, currency = currency.NONE)
// 7 / 2 is 3.5. A float counter visits 3.5, 5.5, 7.5: sum 16.5 (three iterations). An int counter that truncates the start visits 3, 5, 7, 9: sum 24.
float acc = 0.0
for i = 7 / 2 to 9 by 2
    acc := acc + i
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1 + acc / 100)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
