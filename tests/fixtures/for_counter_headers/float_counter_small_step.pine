//@version=6
strategy("Small float step", currency = currency.USDT, initial_capital = 1000000)
pf_count = 0
for pf_v = 0.0 to 0.000003 - 0.000000000000000001 by 0.000001
    pf_count += 1
if bar_index % 8 == 0
    strategy.entry("pf_long", strategy.long, qty = 1 + pf_count / 100)
if bar_index % 8 == 1
    strategy.close("pf_long")
