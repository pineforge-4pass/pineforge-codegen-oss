//@version=6
strategy("Counter in the end bound, same name declared after the loop", initial_capital = 1000000, currency = currency.NONE)
float acc = 0.0
for i = 0 to (i == 0 ? 3 : 1)
    acc := acc + i + 1
int i = 0
// 3 if the end bound reads the loop counter (the later declaration is not visible there); 10 if it reads the global declared after the loop
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = acc)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
