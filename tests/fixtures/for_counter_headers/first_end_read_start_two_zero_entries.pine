//@version=6
strategy("First end read with zero entry quantity", initial_capital = 1000000, currency = currency.NONE)
float acc = 0.0
for i = 2 to (i == 2 ? 3 : 1)
    acc := acc + i + 1
// TradingView measurement: zero entries; the accumulator stays zero.
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = acc)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
