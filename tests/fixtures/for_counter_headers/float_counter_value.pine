//@version=6
strategy("Float counter value accumulated", initial_capital = 1000000, currency = currency.NONE)
float acc = 0.0
for x = 0.0 to 1.0 by 0.25
    acc += x
// TradingView measurement: quantity 2.5 preserves the fractional counter values.
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = acc)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
