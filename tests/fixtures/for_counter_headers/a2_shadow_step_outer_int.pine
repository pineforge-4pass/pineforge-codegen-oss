//@version=6
strategy("Counter shadows an outer variable in the step", initial_capital = 1000000, currency = currency.NONE)
int i = 1
float acc = 0.0
for i = 0 to 4 by (i == 0 ? 1 : 2)
    acc := acc + i + 1
// 15 if the step reads the loop counter at its start value 0; 9 if it reads the outer variable i, which is 1
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = acc)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
