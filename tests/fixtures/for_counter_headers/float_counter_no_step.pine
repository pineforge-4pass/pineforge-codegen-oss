//@version=6
strategy("Float counter without explicit step", currency=currency.NONE, initial_capital=1000000)
float acc = 0.0
for x = 0.0 to 2.0
    acc += 1.0
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = acc)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
