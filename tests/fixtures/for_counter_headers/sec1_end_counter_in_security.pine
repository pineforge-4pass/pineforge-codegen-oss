//@version=6
strategy("Counter in the end bound inside a security expression", initial_capital = 1000000, currency = currency.NONE)
total() =>
    float acc = 0.0
    for i = 0 to (i == 0 ? 3 : 1)
        acc := acc + i + 1
    acc
tradeQty = request.security(syminfo.tickerid, timeframe.period, total())
// 3 if the end bound is read again before every iteration (as in the plain probe); 10 if it is read once
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = tradeQty)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
