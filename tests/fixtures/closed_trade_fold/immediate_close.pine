//@version=6
strategy("Immediate close before totals", initial_capital = 1000000, process_orders_on_close = false, calc_on_order_fills = false)

beforeClose = strategy.closedtrades
varip int actionBar = -1
varip int calculations = 0
calculations += 1
if actionBar != bar_index
    actionBar := bar_index
    if bar_index % 8 == 0
        strategy.entry("Long", strategy.long, qty = 1)
    if bar_index % 8 == 4
        strategy.entry("Short", strategy.short, qty = 1)
    if bar_index % 8 == 2
        strategy.close("Long", immediately = true)
    if bar_index % 8 == 6
        strategy.close("Short", immediately = true)
afterClose = strategy.closedtrades

int rows = 0
float total = -0.5
if strategy.closedtrades > 0
    for i = 0 to strategy.closedtrades - 1
        entryId = strategy.closedtrades.entry_id(i)
        profit = strategy.closedtrades.profit(i)
        rows += 1
        total += profit
        // fold-body-end

// @pf-trace rows=rows
// @pf-trace total=total
// @pf-trace closedCount=strategy.closedtrades
// @pf-trace beforeClose=beforeClose
// @pf-trace afterClose=afterClose
// @pf-trace calculations=calculations
