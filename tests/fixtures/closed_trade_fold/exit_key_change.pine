//@version=6
strategy("Trailing bracket order changes", initial_capital = 1000000, pyramiding = 3, process_orders_on_close = true, calc_on_order_fills = false)

varip int actionBar = -1
if actionBar != bar_index
    actionBar := bar_index
    if bar_index == 0
        strategy.entry("Long", strategy.long, qty = 3)
    if bar_index == 1
        strategy.exit("X", limit = 101, qty = 1, oca_name = "first")
        strategy.exit("Y", from_entry = "Long", limit = 102, qty = 1, oca_name = "second")
    if bar_index == 3
        strategy.exit("X", from_entry = "Long", limit = 1000000, qty = 1, oca_name = "first")
    if bar_index == 5
        strategy.cancel_all()
        strategy.close_all(immediately = true)
    if bar_index >= 8
        if bar_index % 4 == 0
            strategy.entry("Long", strategy.long, qty = 1)
        if bar_index % 4 == 2
            strategy.close_all()

int rows = 0
float seededProfit = 9007199254740992.0
float total = 0.0
if strategy.closedtrades > 0
    for i = 0 to strategy.closedtrades - 1
        entryId = strategy.closedtrades.entry_id(i)
        profit = strategy.closedtrades.profit(i)
        rows += 1
        seededProfit += profit
        total += profit
        // fold-body-end

int firstExit = 0
if strategy.closedtrades == 2
    if strategy.closedtrades.exit_id(strategy.closedtrades - 2) == "X"
        firstExit := 1
    if strategy.closedtrades.exit_id(strategy.closedtrades - 2) == "Y"
        firstExit := 2
// @pf-trace rows=rows
// @pf-trace seededProfit=seededProfit
// @pf-trace total=total
// @pf-trace closedCount=strategy.closedtrades
// @pf-trace firstExit=firstExit
