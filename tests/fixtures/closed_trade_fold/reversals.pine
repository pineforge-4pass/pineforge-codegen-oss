//@version=6
strategy("Alternating entry reversals", initial_capital = 1000000, process_orders_on_close = true, calc_on_order_fills = false, commission_type = strategy.commission.percent, commission_value = 0.0375)

varip int actionBar = -1
if actionBar != bar_index
    actionBar := bar_index
    if bar_index % 8 == 0
        strategy.entry("Long", strategy.long, qty = 1)
    if bar_index % 8 == 4
        strategy.entry("Short", strategy.short, qty = 1)
    if barstate.islast
        strategy.close_all(immediately = true, comment = "flatten")

int longRows = 0
int shortRows = 0
float total = 0.0
if strategy.closedtrades > 0
    for i = 0 to strategy.closedtrades - 1
        entryId = strategy.closedtrades.entry_id(i)
        profit = strategy.closedtrades.profit(i)
        if entryId == "Long"
            longRows += 1
        if entryId == "Short"
            shortRows += 1
        total += profit
        // fold-body-end

// @pf-trace longRows=longRows
// @pf-trace shortRows=shortRows
// @pf-trace total=total
// @pf-trace closedCount=strategy.closedtrades
