//@version=6
strategy("Ended branch visibility", overlay = true, initial_capital = 1000000)
// A function's branch-local declaration does not survive the branch's end.
probe() =>
    if close > open
        float branchValue = close - open
    branchValue
signalValue = probe()
plot(signalValue, "signal")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
