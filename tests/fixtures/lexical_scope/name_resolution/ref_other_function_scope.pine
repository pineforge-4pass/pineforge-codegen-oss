//@version=6
strategy("Separate function visibility", overlay = true, initial_capital = 1000000)
// The first function's local is not a global and cannot bind the second function's read.
first() =>
    float privateValue = close - open
    privateValue
second() => privateValue
signalValue = first() + second()
plot(signalValue, "signal")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
