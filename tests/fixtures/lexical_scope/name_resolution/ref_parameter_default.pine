//@version=6
strategy("Parameter default declaration order", overlay = true, initial_capital = 1000000)
// The default mentions a name not yet introduced; default-expression typing may also refuse it.
probe(float value = lateValue) => value
float lateValue = close - open
signalValue = probe()
plot(signalValue, "signal")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
