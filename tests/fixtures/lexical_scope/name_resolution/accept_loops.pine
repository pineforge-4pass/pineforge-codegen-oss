//@version=6
strategy("Earlier loop bindings", overlay = true, initial_capital = 1000000)
// Counted and while loops each add close-open twice; the iterable loop adds close+open.
probe() =>
    total = 0.0
    int limit = 1
    for counter = 0 to limit
        float localValue = close - open
        total += localValue
    items = array.from(close, open)
    for item in items
        float localValue = item
        total += localValue
    int counter = 0
    while counter < 2
        float localValue = close - open
        total += localValue
        counter += 1
    total + items.size()
signalValue = probe()
plot(signalValue, "signal")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
