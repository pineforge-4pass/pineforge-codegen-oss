//@version=6
strategy("Parameter before later global", overlay = true, initial_capital = 1000000)
// The body's name binds the parameter; the later global is read only at the later call.
probe(float lateValue) => lateValue
float lateValue = close - open
signalValue = probe(lateValue)
plot(signalValue, "signal")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
