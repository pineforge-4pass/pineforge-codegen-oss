//@version=6
strategy("Earlier conditional bindings", overlay = true, initial_capital = 1000000)
// Each branch owns its local; the nested read sees the earlier enclosing declaration.
probe() =>
    total = 0.0
    float outerValue = close - open
    if close > open
        float branchValue = outerValue
        if bar_index >= 0
            total := branchValue
    else
        float branchValue = outerValue
        total := branchValue
    total
signalValue = probe()
if close > open
    float localValue = close - open
    signalValue := localValue
plot(signalValue, "signal")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
