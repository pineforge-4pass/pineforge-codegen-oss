//@version=6
strategy("Earlier switch bindings", overlay = true, initial_capital = 1000000)
// The same local spelling in different arms is legal; each arm binds it before reading it.
probe() =>
    switch close > open
        true =>
            float localValue = close - open
            localValue
        =>
            float localValue = open - close
            localValue
signalValue = probe()
plot(signalValue, "signal")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
