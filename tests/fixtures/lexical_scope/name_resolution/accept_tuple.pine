//@version=6
strategy("Earlier tuple bindings", overlay = true, initial_capital = 1000000)
// Both tuple elements exist when the later expression reads them.
pair() => [close, open]
probe() =>
    [lateValue, otherValue] = pair()
    value = lateValue
    value + otherValue
signalValue = probe()
plot(signalValue, "signal")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
