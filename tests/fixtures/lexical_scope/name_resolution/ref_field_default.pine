//@version=6
strategy("Field default declaration order", overlay = true, initial_capital = 1000000)
// A field default is visited at the type declaration, before the named global exists.
type Reading
    float value = lateValue
float lateValue = close - open
reading = Reading.new()
signalValue = reading.value
plot(signalValue, "signal")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
