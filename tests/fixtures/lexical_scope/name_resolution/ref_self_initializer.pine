//@version=6
strategy("Initializer visibility without outer binding", overlay = true, initial_capital = 1000000)
// Its own declaration cannot supply the initializer's missing outer binding.
probe() =>
    float lateValue = lateValue + 1.0
    lateValue
signalValue = probe()
plot(signalValue, "signal")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
