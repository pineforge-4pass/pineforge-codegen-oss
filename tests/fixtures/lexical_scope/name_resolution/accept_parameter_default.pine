//@version=6
strategy("Literal parameter default", overlay = true, initial_capital = 1000000)
// A literal default has no unresolved name; the omitted argument yields one.
probe(float value = 1.0) => value
signalValue = probe()
plot(signalValue, "signal")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
