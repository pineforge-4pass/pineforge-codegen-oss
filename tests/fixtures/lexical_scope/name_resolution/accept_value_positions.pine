//@version=6
strategy("Earlier bindings in value positions", overlay = true, initial_capital = 1000000)
// Condition, argument and both ternary arms read existing bindings; reassignment stays local.
probe() =>
    float lateValue = close - open
    bool lateGate = close > open
    value = false ? lateValue : math.abs(lateValue)
    if lateGate
        value := lateValue
    value
signalValue = probe()
plot(signalValue, "signal")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
