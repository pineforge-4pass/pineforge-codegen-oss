//@version=6
strategy("Initializer outer binding", overlay = true, initial_capital = 1000000)
// If TV accepts this shadow, the initializer reads the earlier global, yielding close-open+1.
float lateValue = close - open
probe() =>
    float lateValue = lateValue + 1.0
    lateValue
signalValue = probe()
plot(signalValue, "signal")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
