//@version=6
strategy("Visible iterable binders", overlay = true, initial_capital = 1000000)
// The indexed loop reads both in-scope binders, giving close+open+1.
probe() =>
    total = 0.0
    for [index, item] in array.from(close, open)
        total += item + index
    total
signalValue = probe()
plot(signalValue, "signal")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
