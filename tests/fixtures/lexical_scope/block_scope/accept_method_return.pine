//@version=6
strategy("Method result captures local", currency = currency.NONE, initial_capital = 1000000)
// Derived: inside is returned while in method scope; signalValue stores the result.
method readValue(float self) =>
    float inside = self - open
    inside
signalValue = close.readValue()
plot(signalValue)
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
