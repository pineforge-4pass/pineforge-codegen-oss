//@version=6
strategy("Local in sibling function", currency = currency.NONE)
// Derived: sibling callable bodies have distinct declaration environments.
firstValue() =>
    float inside = close - open
    inside
secondValue() =>
    inside + 1.0
signalValue = firstValue() + secondValue()
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
