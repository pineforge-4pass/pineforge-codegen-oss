//@version=6
strategy("Function while local after loop", currency = currency.NONE)
// Derived: the callable's while body currently reuses its enclosing symbol scope.
readValue() =>
    int remaining = 1
    while remaining > 0
        float inside = close - open
        remaining := remaining - 1
    inside
signalValue = readValue()
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
