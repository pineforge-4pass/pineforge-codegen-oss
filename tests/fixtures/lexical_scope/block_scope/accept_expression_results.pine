//@version=6
strategy("Block expressions export values", currency = currency.NONE, initial_capital = 1000000)
// Derived: each expression exports its final value; neither exports its inside declaration.
ifResult = if bar_index >= 0
    float inside = close - open
    inside
else
    open - close
switchResult = switch bar_index % 2
    0 =>
        float inside = close
        inside
    =>
        open
signalValue = ifResult + switchResult
plot(signalValue)
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
