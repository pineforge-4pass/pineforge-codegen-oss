//@version=6
strategy("Local reads and outer writes", currency = currency.NONE, initial_capital = 1000000)
// Derived: each read stays in its declaring block; signalValue is the outer accumulator.
float signalValue = 0.0
for i = 0 to 1
    float counted = close - open
    if i == 1
        signalValue := signalValue + counted + i
values = array.from(close, open)
for [index, value] in values
    float element = value
    signalValue := signalValue + element + index
int remaining = 1
while remaining > 0
    float repeated = close
    signalValue := signalValue + repeated
    remaining := remaining - 1
if bar_index % 2 == 0
    float branchValue = close
    signalValue := signalValue + branchValue
else
    float branchValue = open
    signalValue := signalValue + branchValue
switch bar_index % 2
    0 =>
        float caseValue = close
        signalValue := signalValue + caseValue
    =>
        float caseValue = open
        signalValue := signalValue + caseValue
plot(signalValue)
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
