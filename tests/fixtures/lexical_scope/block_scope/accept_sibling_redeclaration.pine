//@version=6
strategy("Sibling declarations are independent", currency = currency.NONE, initial_capital = 1000000)
// Derived: each same-spelled declaration is read in its own sibling block.
float signalValue = 0.0
if bar_index % 2 == 0
    float inside = close
    signalValue := inside
else
    float inside = open
    signalValue := inside
plot(signalValue)
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
