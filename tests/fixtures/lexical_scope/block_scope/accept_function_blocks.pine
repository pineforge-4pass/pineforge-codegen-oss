//@version=6
strategy("Function block captures", currency = currency.NONE, initial_capital = 1000000)
// Derived: inner blocks write an outer callable local; each inside read stays in its block.
readValue() =>
    float result = 0.0
    if bar_index >= 0
        float inside = close - open
        result := inside
    int remaining = 1
    while remaining > 0
        float inside = open
        result := result + inside
        remaining := remaining - 1
    switch bar_index % 2
        0 =>
            float inside = close
            result := result + inside
        =>
            float inside = open
            result := result + inside
    result
signalValue = readValue()
plot(signalValue)
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
