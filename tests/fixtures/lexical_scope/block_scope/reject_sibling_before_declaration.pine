//@version=6
strategy("Earlier sibling cannot see later local", currency = currency.NONE)
// Derived: visibility depends on lexical ownership, not visitor order.
float signalValue = 0.0
if bar_index % 2 == 0
    signalValue := inside
else
    float inside = close - open
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
