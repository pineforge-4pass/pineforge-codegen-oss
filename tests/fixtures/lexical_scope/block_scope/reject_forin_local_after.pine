//@version=6
strategy("For in body local after loop", currency = currency.NONE)
// Derived: the body declaration is removed with the for-in scope.
values = array.from(close, open)
float signalValue = 0.0
for value in values
    float inside = value
    signalValue := inside
signalValue := inside
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
