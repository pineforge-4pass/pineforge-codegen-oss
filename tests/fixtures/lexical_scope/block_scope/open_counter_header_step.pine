//@version=6
strategy("Counter binding in step expression", currency = currency.NONE, initial_capital = 1000000)
// Open: the step is emitted before the C++ for initializer; TV visibility needs a tape.
float signalValue = 0.0
for i = 0 to 1 by (i == 0 ? 1 : 2)
    signalValue := i
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
