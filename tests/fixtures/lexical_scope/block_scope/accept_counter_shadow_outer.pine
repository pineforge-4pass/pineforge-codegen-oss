//@version=6
strategy("Outer counter spelling survives", currency = currency.NONE, initial_capital = 1000000)
// Derived: the loop's fresh i runs 0,1; the outer i stays bar_index + 10.
int i = bar_index + 10
float signalValue = 0.0
for i = 0 to 1
    signalValue := i
signalValue := signalValue + i
plot(signalValue)
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
