//@version=6
strategy("Function local outside function", currency = currency.NONE)
// Derived: the callable scope exits, but the global emission name union keeps inside.
readValue() =>
    float inside = close - open
    inside
signalValue = readValue()
signalValue := inside
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
