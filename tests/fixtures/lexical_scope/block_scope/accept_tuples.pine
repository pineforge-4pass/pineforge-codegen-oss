//@version=6
strategy("Tuple elements read in their block", currency = currency.NONE, initial_capital = 1000000)
// Derived: both tuple elements are read before the loop scope exits.
pairValue() => [close, open]
float signalValue = 0.0
for i = 0 to 1
    [inside, other] = pairValue()
    signalValue := inside - other
plot(signalValue)
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
