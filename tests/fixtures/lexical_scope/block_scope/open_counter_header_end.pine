//@version=6
strategy("Counter binding in final bound", currency = currency.NONE, initial_capital = 1000000)
// Open: TV must decide visibility in the dynamic end expression separately from the body.
float signalValue = 0.0
for i = 0 to (i == 0 ? 1 : 0)
    signalValue := i
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
