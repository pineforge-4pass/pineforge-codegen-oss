//@version=6
strategy("Outer and builtin restored", currency = currency.NONE, initial_capital = 1000000)
// Derived: after shadows end, close is the bar field and outerValue is the earlier global.
float outerValue = open
float signalValue = 0.0
if bar_index >= 0
    float close = 1.0
    float outerValue = 2.0
    signalValue := close + outerValue
signalValue := signalValue + close + outerValue
plot(signalValue)
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
