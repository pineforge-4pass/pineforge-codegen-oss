//@version=6
strategy("Function if local after block", currency = currency.NONE)
// Derived: callable collection tracking disables the existing script-only owner marker.
readValue() =>
    if bar_index >= 0
        float inside = close - open
    inside
signalValue = readValue()
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
