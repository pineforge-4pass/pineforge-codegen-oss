//@version=6
strategy("Loop tuple binding after loop", currency = currency.NONE)
// Derived: each tuple element is a declaration in the surrounding loop body.
pairValue() => [close, open]
float signalValue = 0.0
for i = 0 to 1
    [inside, other] = pairValue()
    signalValue := inside - other
signalValue := inside
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
