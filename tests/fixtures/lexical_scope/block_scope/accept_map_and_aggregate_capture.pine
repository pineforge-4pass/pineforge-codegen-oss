//@version=6
strategy("Map and aggregate values explicitly captured", currency = currency.NONE, initial_capital = 1000000)
// Derived: captures are outer declarations; iteration and array locals are read only inside their loops.
values = map.new<string, float>()
values.put("sample", close)
string capturedKey = ""
float signalValue = 0.0
for [mapKey, mapValue] in values
    capturedKey := mapKey
    signalValue := mapValue
array<float> captured = array.new<float>()
for i = 0 to 1
    array<float> inside = array.from(close, open)
    captured := inside
signalValue := signalValue + array.get(captured, 0)
plot(signalValue)
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
