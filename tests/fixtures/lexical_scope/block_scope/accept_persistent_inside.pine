//@version=6
strategy("Persistent locals stay inside scope", currency = currency.NONE, initial_capital = 1000000)
// Derived: both persistent declarations are read in their loop; only the sum escapes.
float signalValue = 0.0
for i = 0 to 1
    var float persistent = close
    varip float intrabar = open
    signalValue := persistent + intrabar
plot(signalValue)
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
