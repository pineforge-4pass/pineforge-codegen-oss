//@version=6
strategy("Locals leave functions through results", currency = currency.NONE, initial_capital = 1000000)
// Derived: firstValue returns close-open; secondValue receives that value through its parameter.
firstValue() =>
    float inside = close - open
    inside
secondValue(float parameter) =>
    float inside = parameter + 1.0
    inside
signalValue = secondValue(firstValue())
plot(signalValue)
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
