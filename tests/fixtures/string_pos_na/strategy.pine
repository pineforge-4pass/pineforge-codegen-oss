//@version=6
// Issue #382 item 5. Candidate public parity probe; no captured TV tape yet.
strategy("382 str.pos missing match", overlay=true, process_orders_on_close=true)

// The literal forms are the public expressions reported in the issue packet.
literalNa = na(str.pos("abc", "x"))
literalNz = nz(str.pos("abc", "x"), 0)

// Both arguments vary at run time; neither possible needle occurs in its source.
source = bar_index % 2 == 0 ? "abc" : "ab"
needle = bar_index % 2 == 0 ? "x" : "z"
variablePos = str.pos(source, needle)
variableNa = na(variablePos)
variableNz = nz(variablePos, 0)

longPos = str.pos("abc", "abcdef")
longNa = na(longPos)
longNz = nz(longPos, 0)

// ASCII controls: a match at zero, another found position and an empty needle.
startPos = str.pos("abc", "a")
foundPos = str.pos("abc", "b")
emptyPos = str.pos("abc", "")

report = "literal_na=" + str.tostring(literalNa) + "|literal_nz=" + str.tostring(literalNz)
report += "|variable_na=" + str.tostring(variableNa) + "|variable_nz=" + str.tostring(variableNz)
report += "|long_na=" + str.tostring(longNa) + "|long_nz=" + str.tostring(longNz)
report += "|start=" + str.tostring(startPos) + "|found=" + str.tostring(foundPos) + "|empty=" + str.tostring(emptyPos)

if bar_index == 0
    strategy.entry("probe", strategy.long, qty=1)
if bar_index == 1
    strategy.close("probe", comment=report)

plot(close)
