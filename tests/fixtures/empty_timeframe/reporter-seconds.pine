//@version=6
strategy("timeframe.in_seconds empty string", overlay = true, initial_capital = 10000)
fast = ta.ema(close, 10)
slow = ta.ema(close, 30)
secs = timeframe.in_seconds("")
// @pf-trace secs=secs
if ta.crossover(fast, slow)
    strategy.entry("Long", strategy.long, qty = 0.01)
if ta.crossunder(fast, slow)
    strategy.close("Long")
