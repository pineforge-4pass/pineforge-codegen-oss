//@version=6
// CG-SILENT-2 item 5g: str.tostring inside a request.security tuple payload.
// Each close's comment spells the requested strings and flag (from 02:00 UTC
// on, when the requested bars lie inside the tape's range).
strategy("CGS2 tostring tuple payload", overlay = true, default_qty_type = strategy.fixed, default_qty_value = 1)
[x, y] = request.security(syminfo.tickerid, "60", [str.tostring(close), close > open])
[p, q] = request.security(syminfo.tickerid, "60", [str.tostring(high - low, "#.##"), str.format("{0,number,#.###}", open * 3)])
live = time >= timestamp("UTC", 2025, 4, 1, 2, 0)
mn = minute(time, "UTC")
if live and (mn == 0 or mn == 30)
    strategy.entry("L", strategy.long)
if mn == 15 or mn == 45
    strategy.close("L", comment = x + "|" + (y ? "up" : "down") + "|" + p + "|" + q)
