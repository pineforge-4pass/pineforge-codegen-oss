//@version=6
// CG-SILENT-2 item 4: a function-local float assigned time keeps float's na.
// On the first bar x[1] is na, so x - x[1] is na; afterwards it is the bar
// spacing. Each close's comment spells what the script reads on that bar.
strategy("CGS2 float time local", overlay = true, default_qty_type = strategy.fixed, default_qty_value = 1)
f() =>
    float x = time
    x - x[1]
g() =>
    float y = time_close
    na(y[1]) ? -1.0 : y - y[1]
d = f()
e = g()
var float firstD = -2.0
var float firstE = -2.0
if barstate.isfirst
    firstD := d
    firstE := e
s(v) => na(v) ? "na" : str.tostring(v)
mn = minute(time, "UTC")
if mn == 0 or mn == 30
    strategy.entry("L", strategy.long)
if mn == 15 or mn == 45
    strategy.close("L", comment = s(firstD) + "|" + s(firstE) + "|" + s(d) + "|" + s(e))
