//@version=6
// CG-SILENT-2 item 5c: a helper called on its own result inside a
// request.security payload, u(u(close)), beside u(open). Each close's
// comment spells the requested values (from 06:00 UTC on, when every
// requested window lies inside the tape's range).
strategy("CGS2 nested helper payload", overlay = true, default_qty_type = strategy.fixed, default_qty_value = 1)
u(_x) => ta.sma(_x, 3)
a = request.security(syminfo.tickerid, "60", u(u(close)) + u(open))
b = request.security(syminfo.tickerid, "60", u(u(u(high))))
live = time >= timestamp("UTC", 2025, 4, 1, 6, 0)
mn = minute(time, "UTC")
if live and (mn == 0 or mn == 30)
    strategy.entry("L", strategy.long)
if mn == 15 or mn == 45
    strategy.close("L", comment = str.tostring(a, "#.####") + "|" + str.tostring(b, "#.####"))
