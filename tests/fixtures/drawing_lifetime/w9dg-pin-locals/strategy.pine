//@version=6
strategy("W9 readout: local variables and the box collection", overlay=true, max_boxes_count=5, pyramiding=20, default_qty_type=strategy.fixed, default_qty_value=0.01)

// Lane CG-W9-MISC. On a chart that keeps five boxes, four boxes are drawn at
// 00:00 UTC on 2025-04-09, oldest first, each also kept in a var array (which
// does not keep a box from the collection) so it can be read later: K1 (top
// 101) held by a local of an if block, K2 (102) by a local of a function,
// K3 (103) by a local of a for loop, K4 (104) by a non-var global assigned on
// that bar only. From 00:15 one filler box is drawn every bar, so the
// collection runs when the seventh filler lands at 01:45. Each readout is an
// entry whose comment carries the four tops.
t(h, m) => timestamp("UTC", 2025, 4, 9, h, m)
var array<box> ka = array.new_box()
mk() =>
    b2 = box.new(bar_index, 102.0, bar_index + 1, 2.0)
    b2
box g = na
if time == t(0, 0)
    bk = box.new(bar_index, 101.0, bar_index + 1, 1.0)
    array.push(ka, bk)
    array.push(ka, mk())
    for i = 0 to 0
        lb = box.new(bar_index, 103.0, bar_index + 1, 3.0)
        array.push(ka, lb)
    g := box.new(bar_index, 104.0, bar_index + 1, 4.0)
    array.push(ka, g)
if time >= t(0, 15) and time <= t(12, 0)
    box.new(bar_index, 200.0, bar_index + 1, 100.0)
tag(string n) =>
    n + ":" + str.tostring(box.get_top(array.get(ka, 0))) + "/" + str.tostring(box.get_top(array.get(ka, 1))) + "/" + str.tostring(box.get_top(array.get(ka, 2))) + "/" + str.tostring(box.get_top(array.get(ka, 3)))
if time == t(1, 30)
    strategy.entry("R1", strategy.long, comment=tag("before"))
if time == t(1, 45)
    strategy.entry("R2", strategy.long, comment=tag("first"))
if time == t(3, 30)
    strategy.entry("R3", strategy.long, comment=tag("second"))
if time == t(13, 0)
    strategy.close_all(comment="cleanup")
