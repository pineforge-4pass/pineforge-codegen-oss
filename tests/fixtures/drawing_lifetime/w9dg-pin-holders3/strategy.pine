//@version=6
strategy("W9 readout: which holders keep a box from the collection (3)", overlay=true, max_boxes_count=5, pyramiding=20, default_qty_type=strategy.fixed, default_qty_value=0.01)

// Lane CG-W9-MISC. On a chart that keeps five boxes, six boxes are drawn at
// 00:00 UTC on 2025-04-09, oldest first, each held one way: U (top 101) in a
// field of an object held by a var, P (102) in a var array and, every bar
// before any filler is drawn, in a non-var global read from that array, F (103)
// in a function's var, W (105) in a field of an object kept in a var array,
// Q (104) in the var array only, O (106) in a var box and a var array. At 00:15
// the var box is reassigned to R (107), so only the array still holds O. From
// 00:30 one filler box is drawn every bar, so the collection runs when the
// fourth filler lands at 01:15. Each readout is an entry whose comment carries
// the seven tops.
type Holder
    box bx
t(h, m) => timestamp("UTC", 2025, 4, 9, h, m)
var Holder u = na
var array<Holder> w = array.new<Holder>()
var array<box> keep = array.new_box()
var box o = na
keepF(bool make) =>
    var box fb = na
    if make
        fb := box.new(bar_index, 103.0, bar_index + 1, 3.0)
    fb
if time == t(0, 0)
    u := Holder.new(box.new(bar_index, 101.0, bar_index + 1, 1.0))
    array.push(keep, box.new(bar_index, 102.0, bar_index + 1, 2.0))
f = keepF(time == t(0, 0))
if time == t(0, 0)
    array.push(keep, box.new(bar_index, 104.0, bar_index + 1, 4.0))
    array.push(w, Holder.new(box.new(bar_index, 105.0, bar_index + 1, 5.0)))
    o := box.new(bar_index, 106.0, bar_index + 1, 6.0)
    array.push(keep, o)
if time == t(0, 15)
    o := box.new(bar_index, 107.0, bar_index + 1, 7.0)
p = array.size(keep) > 0 ? array.get(keep, 0) : na
if time >= t(0, 30) and time <= t(12, 0)
    box.new(bar_index, 200.0, bar_index + 1, 100.0)
tag(string n) =>
    n + ":" + str.tostring(box.get_top(u.bx)) + "/" + str.tostring(box.get_top(array.get(keep, 0))) + "/" + str.tostring(box.get_top(f)) + "/" + str.tostring(box.get_top(array.get(keep, 1))) + "/" + str.tostring(box.get_top(array.get(w, 0).bx)) + "/" + str.tostring(box.get_top(array.get(keep, 2))) + "/" + str.tostring(box.get_top(o))
if time == t(1, 0)
    strategy.entry("R1", strategy.long, comment=tag("before"))
if time == t(1, 15)
    strategy.entry("R2", strategy.long, comment=tag("first"))
if time == t(3, 0)
    strategy.entry("R3", strategy.long, comment=tag("second"))
if time == t(13, 0)
    strategy.close_all(comment="cleanup")
