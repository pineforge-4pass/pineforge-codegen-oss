//@version=6
strategy("W8B readout: a box evicted by max_boxes_count", overlay=true, max_boxes_count=5, pyramiding=10, default_qty_type=strategy.fixed, default_qty_value=0.01)

// Lane W8B-SIGSTATE-2. On a chart that keeps five boxes, A (top 111) is the
// oldest of six. Every readout is an entry whose comment carries a box's top:
// R1 with five boxes live, R2 on the bar the sixth is drawn (after it), R3 a
// bar later. D (top 333) is the control deleted with box.delete (R4).
t(h, m) => timestamp("UTC", 2025, 4, 8, h, m)
var box a = na
var box d = na
if time == t(0, 0)
    a := box.new(bar_index, 111.0, bar_index + 1, 11.0)
if time == t(0, 15) or time == t(0, 30) or time == t(0, 45) or time == t(1, 0)
    box.new(bar_index, 200.0, bar_index + 1, 100.0)
if time == t(1, 0)
    strategy.entry("R1", strategy.long, comment="five:" + str.tostring(box.get_top(a)))
if time == t(1, 15)
    box.new(bar_index, 200.0, bar_index + 1, 100.0)
    strategy.entry("R2", strategy.long, comment="six-samebar:" + str.tostring(box.get_top(a)))
if time == t(1, 30)
    strategy.entry("R3", strategy.long, comment="six-nextbar:" + str.tostring(box.get_top(a)))
if time == t(2, 0)
    d := box.new(bar_index, 333.0, bar_index + 1, 33.0)
if time == t(2, 15)
    box.delete(d)
    strategy.entry("R4", strategy.long, comment="deleted:" + str.tostring(box.get_top(d)))
if time == t(3, 0)
    strategy.close_all(comment="cleanup")
