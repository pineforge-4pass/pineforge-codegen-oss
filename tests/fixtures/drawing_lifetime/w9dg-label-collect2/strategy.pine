//@version=6
strategy("W9 readout: when and which labels max_labels_count collects (2)", overlay=true, max_labels_count=5, pyramiding=30, default_qty_type=strategy.fixed, default_qty_value=0.01)

// Lane CG-W9-MISC. On a chart that keeps five labels: A (y 111) is kept in a
// var label only, B (y 222) in a var array only, C (y 333) in both. They are
// drawn at 00:00, 00:15 and 00:30 on 2025-04-09, then one filler label every
// bar from 00:45 (the eleventh label is drawn at 02:30). Every bar from 02:00
// to 03:00 an entry's comment carries A's, B's and C's y and B's x.
t(h, m) => timestamp("UTC", 2025, 4, 9, h, m)
var array<label> keep = array.new_label()
var label a = na
var label c = na
if time == t(0, 0)
    a := label.new(bar_index, 111.0, "a")
if time == t(0, 15)
    array.push(keep, label.new(bar_index, 222.0, "b"))
if time == t(0, 30)
    c := label.new(bar_index, 333.0, "c")
    array.push(keep, c)
if time >= t(0, 45) and time <= t(12, 0)
    label.new(bar_index, 200.0, "f")
if time >= t(2, 0) and time <= t(3, 0)
    strategy.entry("R" + str.tostring(bar_index), strategy.long, comment=str.format("{0}|{1}|{2}|{3}", str.tostring(label.get_y(a)), str.tostring(label.get_y(array.get(keep, 0))), str.tostring(label.get_y(array.get(keep, 1))), str.tostring(label.get_x(array.get(keep, 0)))))
if time == t(13, 0)
    strategy.close_all(comment="cleanup")
