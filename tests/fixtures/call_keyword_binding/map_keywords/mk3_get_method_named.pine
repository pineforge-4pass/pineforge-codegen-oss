//@version=6
strategy("Map get method named", initial_capital = 1000000, currency = currency.NONE)
values = map.new<string, float>()
map.put(values, "a", 4.0)
metric = values.get(key = "a")
if metric < 0
    strategy.cancel("L")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
