//@version=6
strategy("Method positional prefix", initial_capital = 1000000, currency = currency.NONE)
type Counter
    float value
method advance(Counter self, float delta, float scale = 2.0) =>
    self.value + delta * scale
counter = Counter.new(1.0)
// Explicit scale and its declared default each produce 1 + 3 * 2 = 7.
metric = counter.advance(3.0, scale = 2.0) + counter.advance(delta = 3.0)
if metric < 0
    strategy.cancel("L")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
