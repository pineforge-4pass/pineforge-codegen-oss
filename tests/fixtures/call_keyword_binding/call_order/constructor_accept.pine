//@version=6
strategy("Constructor positional prefix", initial_capital = 1000000, currency = currency.NONE)
type Pair
    float left
    float right = 2.0
// Explicit right and omitted right both initialize the pair to (1, 2).
pair = Pair.new(1.0, right = 2.0)
other = Pair.new(left = 1.0)
metric = pair.left + pair.right + other.left + other.right
if metric < 0
    strategy.cancel("L")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
