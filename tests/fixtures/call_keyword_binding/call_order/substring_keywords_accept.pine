//@version=6
strategy("Substring named arguments", initial_capital = 1000000, currency = currency.NONE)
// Keyword slots are source, begin_pos and end_pos despite their written order.
metric = str.length(str.substring(end_pos = 4, source = "quantity", begin_pos = 1))
if metric < 0
    strategy.cancel("L")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
