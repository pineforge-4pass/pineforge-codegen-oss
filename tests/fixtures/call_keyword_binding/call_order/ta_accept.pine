//@version=6
strategy("TA positional prefix", initial_capital = 1000000, currency = currency.NONE)
// Source precedes length; after warmup the metric is the three-close mean.
metric = ta.sma(close, length = 3)
if metric < 0
    strategy.cancel("L")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
