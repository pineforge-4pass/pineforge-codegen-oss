//@version=6
strategy("Order positional prefix", initial_capital = 1000000, currency = currency.NONE)
// The named quantity follows both required positional parameters.
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
