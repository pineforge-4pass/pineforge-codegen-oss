//@version=6
strategy("Variadic positional arguments", initial_capital = 1000000, currency = currency.NONE)
// The format and value are both positional; formatted 1 has length 1.
metric = str.length(str.format("{0}", 1))
if metric < 0
    strategy.cancel("L")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
