//@version=6
strategy("Matrix method positional prefix", initial_capital = 1000000, currency = currency.NONE)
values = matrix.new<float>(1, 1, 0.0)
// Row 0 and column 0 precede value, leaving the cell equal to 4.
values.set(0, 0, value = 4.0)
metric = values.get(0, 0)
if metric < 0
    strategy.cancel("L")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
