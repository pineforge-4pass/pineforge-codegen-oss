//@version=6
strategy("Substring positional arguments", initial_capital = 1000000, currency = currency.NONE)
// Exclusive end 4 minus begin 1 gives a length of 3.
metric = str.length(str.substring("quantity", 1, 4))
if metric < 0
    strategy.cancel("L")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
