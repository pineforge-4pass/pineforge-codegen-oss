//@version=6
strategy("Builtin positional prefix", initial_capital = 1000000, currency = currency.NONE)
// A present close is retained; only a missing value uses replacement zero.
metric = nz(close, replacement = 0.0)
if metric < 0
    strategy.cancel("L")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
