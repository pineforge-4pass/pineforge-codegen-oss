//@version=6
strategy("Substring omitted end", initial_capital = 1000000, currency = currency.NONE)
// Omitting end_pos keeps the seven characters from index 1 to the end.
metric = str.length(str.substring("quantity", begin_pos = 1))
if metric < 0
    strategy.cancel("L")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
