//@version=6
strategy("Array method positional prefix", initial_capital = 1000000, currency = currency.NONE)
values = array.from(2.0, 3.0, 4.0)
// Slice [0, 2) retains the first element 2.
part = values.slice(0, index_to = 2)
metric = array.get(part, 0)
if metric < 0
    strategy.cancel("L")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
