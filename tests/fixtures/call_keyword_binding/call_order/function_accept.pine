//@version=6
strategy("Function positional prefix", initial_capital = 1000000, currency = currency.NONE)
combine(float left, float right = 4.0) => left + right
// Each call gives 3 + 4 = 7, with an explicit or defaulted right; total is 14.
metric = combine(3.0, right = 4.0) + combine(left = 3.0)
if metric < 0
    strategy.cancel("L")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
