//@version=6
strategy("Calendar positional prefix", initial_capital = 1000000, currency = currency.NONE)
// The positional year precedes month and day; remaining time fields default.
metric = timestamp(2020, month = 1, day = 1)
if metric < 0
    strategy.cancel("L")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
