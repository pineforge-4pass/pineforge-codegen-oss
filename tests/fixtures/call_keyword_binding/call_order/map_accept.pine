//@version=6
strategy("Map function positional prefix", initial_capital = 1000000, currency = currency.NONE)
values = map.new<string, float>()
// id and key precede value; reading key a returns 4.
map.put(values, "a", value = 4.0)
metric = map.get(values, "a")
if metric < 0
    strategy.cancel("L")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
