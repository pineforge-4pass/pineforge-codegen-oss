//@version=6
strategy("Substring positional prefix", initial_capital = 1000000, currency = currency.NONE)
// Two positional arguments precede the keyword suffix; length is 4 - 1.
metric = str.length(str.substring("quantity", 1, end_pos = 4))
if metric < 0
    strategy.cancel("L")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
