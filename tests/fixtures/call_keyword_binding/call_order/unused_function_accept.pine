//@version=6
strategy("Unused function ordered arguments", initial_capital = 1000000, currency = currency.NONE)
// An unused function with ordinary positional and named arguments is legal.
unused() => str.substring("quantity", 1, end_pos = 4)
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
