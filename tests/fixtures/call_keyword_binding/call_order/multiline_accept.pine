//@version=6
strategy("Multiline positional prefix", initial_capital = 1000000, currency = currency.NONE)
// Both positional arguments precede the named end despite line wrapping.
metric = str.length(str.substring(
    "quantity",
    int(bar_index % 3),
    end_pos = 4))
if metric < 0
    strategy.cancel("L")
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
