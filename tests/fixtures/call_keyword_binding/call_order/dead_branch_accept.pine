//@version=6
strategy("Unreachable call ordered arguments", initial_capital = 1000000, currency = currency.NONE)
// Unreachable code remains legal when its argument order is legal.
if false
    strategy.entry("Unused", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 3
    strategy.entry("L", strategy.long, qty = 1)
if bar_index > 6 and bar_index % 7 == 5
    strategy.close("L")
