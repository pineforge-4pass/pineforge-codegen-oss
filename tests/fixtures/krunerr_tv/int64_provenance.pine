//@version=6
strategy("PF KRUNERR int64 provenance", overlay=true, pyramiding=10, default_qty_type=strategy.fixed, default_qty_value=0.01)
const int E1 = timestamp("2025-04-01 00:30 +0000")
const int E2 = timestamp("2025-04-01 00:45 +0000")
const int pick = 2
f_t(int t) => str.tostring(t)
f_plus(int t) => t + 1
int sel = switch pick
    1 => E1
    2 => E2
int tern = pick == 2 ? E2 : E1
var int firstT = na
if na(firstT)
    firstT := time
var int copyT = na
copyT := firstT
int alias = firstT
if bar_index == 3
    strategy.entry("sel=" + str.tostring(sel) + "|tern=" + str.tostring(tern) + "|hit=" + str.tostring(time == sel), strategy.long)
    strategy.entry("copy=" + str.tostring(copyT) + "|alias=" + str.tostring(alias), strategy.long)
    strategy.entry("f=" + f_t(time) + "|g=" + f_t(firstT) + "|p=" + str.tostring(f_plus(time)), strategy.long)
if bar_index == 5
    strategy.close_all()
