//@version=6
strategy("PF KRUNERR array negative index int", overlay=true, pyramiding=10, default_qty_type=strategy.fixed, default_qty_value=0.01)
if bar_index == 3
    a = array.from(10, 20, 30, 40, 50)
    int g1 = array.get(a, -1)
    int g5 = array.get(a, -5)
    array.set(a, -2, 44)
    array.insert(a, -1, 45)
    string s1 = array.join(a, ",")
    int r = array.remove(a, -3)
    string s2 = array.join(a, ",")
    array.insert(a, -5, 5)
    string s3 = array.join(a, ",")
    b = array.from("x", "y", "z")
    string s4 = array.get(b, -2) + array.get(b, -3)
    f = array.from(1.5, 2.5, 3.5)
    string s5 = str.tostring(array.get(f, -1)) + "," + str.tostring(f.get(-3))
    int m = a.get(-1)
    a.set(-1, 99)
    string s6 = str.tostring(a.get(-1)) + "," + str.tostring(m) + "," + str.tostring(a.remove(-1)) + "," + array.join(a, ",")
    strategy.entry("g1=" + str.tostring(g1) + "|g5=" + str.tostring(g5), strategy.long)
    strategy.entry("s1=" + s1, strategy.long)
    strategy.entry("r=" + str.tostring(r) + "|s2=" + s2, strategy.long)
    strategy.entry("s3=" + s3, strategy.long)
    strategy.entry("s4=" + s4 + "|s5=" + s5, strategy.long)
    strategy.entry("s6=" + s6, strategy.long)
if bar_index == 5
    strategy.close_all()
