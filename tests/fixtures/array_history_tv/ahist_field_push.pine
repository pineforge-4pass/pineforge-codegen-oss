//@version=6
// CG-ARRAY-HIST: an element pushed into an array field of an object read through the object's history.
strategy("AHIST stop", overlay = true)
float x = 0.0
type H
    array<float> xs
h = H.new(array.from(close))
if bar_index > 0
    (h[1]).xs.push(1.0)
    x := (h[1]).xs.size()
if bar_index == 5
    strategy.entry("L", strategy.long, comment = str.tostring(x))
