//@version=6
// CG-ARRAY-HIST: more of what an array's history reads. An array changed
// after its declaration, an if block's local changed after the read, a
// dynamic offset, a variable bound to the history (and that variable's own
// history), the history passed to a function, a var array rebound to a new
// array on every fourth bar, and an array of objects changed after its bar.
// Each close's comment spells the values the script reads on that bar.
strategy("AHIST more", overlay = true, default_qty_type = strategy.fixed, default_qty_value = 1)
type Cell
    int v
firstOf(array<int> x) =>
    x.get(0) * 10 + x.size()
b2 = array.from(bar_index)
b2.push(7)
int k = bar_index % 3
var arr = array.new<int>()
if bar_index % 4 == 0
    arr := array.from(bar_index)
arr.push(1)
var cell = Cell.new(0)
ac = array.from(cell)
cell.v := bar_index
int t1 = -1
int t3 = -1
int t5 = -1
int t6 = -1
int t7 = -1
int t9 = -1
int t11 = -1
if bar_index % 2 == 1
    bl = array.from(bar_index)
    t3 := na(bl[1]) ? -1 : (bl[1]).size()
    bl.push(5)
if bar_index >= 3
    t1 := (b2[1]).size()
    t5 := bar_index - (b2[k]).get(0)
    pb = b2[1]
    t6 := pb.get(0) * 100 + pb.size()
    t7 := firstOf(b2[2])
    t9 := (arr[1]).size() * 100 + (arr[1]).get(0) % 100
    t11 := (ac[1]).get(0).v - bar_index
mn = minute(time, "UTC")
if mn == 0 or mn == 30
    strategy.entry("L", strategy.long)
if mn == 15 or mn == 45
    strategy.close("L", comment = str.tostring(t1) + "|" + str.tostring(t3) + "|" + str.tostring(t5) + "|" + str.tostring(t6) + "|" + str.tostring(t7) + "|" + str.tostring(t9) + "|" + str.tostring(t11))
