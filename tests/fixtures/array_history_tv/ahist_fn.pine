//@version=6
// CG-ARRAY-HIST: the history of an array or a matrix inside functions and
// blocks: an array parameter given a fresh array per bar and a var array, a
// function's local array, a matrix parameter, a function's new array read
// through its call's history, and an if block's local array. Each close's
// comment spells the values the script reads on that bar.
strategy("AHIST fn", overlay = true, default_qty_type = strategy.fixed, default_qty_value = 1)
prevFirst(array<int> x) =>
    na(x[1]) ? -1 : (x[1]).get(0)
sameSize(array<int> x) =>
    na(x[1]) ? -1 : x.size() - (x[1]).size()
prevLocal(int k) =>
    la = array.from(k)
    na(la[1]) ? -1 : (la[1]).get(0)
prevCell(matrix<int> x) =>
    na(x[1]) ? -1 : (x[1]).get(0, 0)
mk(int k) =>
    array.from(k)
b = array.from(bar_index)
var va = array.new<int>()
va.push(bar_index)
m = matrix.new<int>(1, 1, bar_index * 2)
a1 = prevFirst(b)
a2 = sameSize(va)
l1 = prevLocal(bar_index * 3)
m1 = prevCell(m)
mc = mk(bar_index * 5)[1]
c1 = na(mc) ? -1 : mc.get(0)
int blk = -3
if bar_index % 2 == 1
    ba = array.from(bar_index * 7)
    blk := na(ba[1]) ? -1 : (ba[1]).get(0)
mn = minute(time, "UTC")
if mn == 0 or mn == 30
    strategy.entry("L", strategy.long)
if mn == 15 or mn == 45
    strategy.close("L", comment = str.tostring(a1) + "|" + str.tostring(a2) + "|" + str.tostring(l1) + "|" + str.tostring(m1) + "|" + str.tostring(c1) + "|" + str.tostring(blk))
