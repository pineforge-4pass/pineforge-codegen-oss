//@version=6
// CG-ARRAY-HIST: a method's array receiver: this[1] is the receiver of the
// previous call, at a call on every bar and at one on every other bar. Each
// close's comment spells the values the script reads on that bar.
strategy("AHIST method", overlay = true, default_qty_type = strategy.fixed, default_qty_value = 1)
method prevFirst(array<int> this) =>
    na(this[1]) ? -1 : (this[1]).get(0)
b = array.from(bar_index)
m1 = b.prevFirst()
int k1 = -2
if bar_index % 2 == 1
    k1 := array.from(bar_index * 100).prevFirst()
mn = minute(time, "UTC")
if mn == 0 or mn == 30
    strategy.entry("L", strategy.long)
if mn == 15 or mn == 45
    strategy.close("L", comment = str.tostring(m1) + "|" + str.tostring(k1))
