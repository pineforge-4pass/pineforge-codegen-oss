//@version=6
// CG-ARRAY-HIST: an element pushed into a copy of an array's history.
strategy("AHIST stop", overlay = true)
float x = 0.0
a = array.from(close)
if bar_index > 0
    c = array.copy(a[1])
    c.push(1.0)
    x := c.size()
if bar_index == 5
    strategy.entry("L", strategy.long, comment = str.tostring(x))
