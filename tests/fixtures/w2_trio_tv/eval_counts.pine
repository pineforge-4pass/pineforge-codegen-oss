//@version=6
strategy("pf-w2-eval-counts", overlay = true)

// Evaluation-count probe. Each shape passes a counting probe, a function that
// adds one to cnt[k] per call and returns its value, through one argument
// slot. Every exit comment spells, per shape, cnt[k] - (bar_index + 1): 0
// when the slot is evaluated once per bar, negative when it is skipped,
// positive when it is evaluated more than once. The last fields spell two
// results.
var cnt = array.new_int(40, 0)
pf(int k, float v) =>
    array.set(cnt, k, array.get(cnt, k) + 1)
    v
pi(int k, int v) =>
    array.set(cnt, k, array.get(cnt, k) + 1)
    v
pb(int k, bool v) =>
    array.set(cnt, k, array.get(cnt, k) + 1)
    v
ps(int k, string v) =>
    array.set(cnt, k, array.get(cnt, k) + 1)
    v
pa(int k) =>
    array.set(cnt, k, array.get(cnt, k) + 1)
    array.from(1.0, 2.0, 3.0)

srt = array.from(1.0, 2.0, 3.0)
astr = array.from("a", "b", "c")
a3 = array.from(1.0, 2.0, 3.0)
s1 = nz(pf(1, close))
s2 = nz(close, pf(2, 0.0))
s3 = fixnan(pf(3, close))
s4 = math.round(close, pi(4, 2))
s5 = str.startswith("abc", ps(5, "a"))
s6 = str.endswith(ps(6, "abc"), "c")
s7 = str.endswith("abc", ps(7, "c"))
s8 = str.substring("abcdef", pi(8, 1), 3)
s9 = str.replace("aXa", ps(9, "X"), "Y")
s10 = str.replace_all("aXaX", ps(10, "X"), "Y")
s11 = str.replace_all("aXaX", "X", ps(11, "Y"))
s12 = str.repeat(ps(12, "ab"), 3)
s13 = str.repeat("ab", pi(13, 3))
s14 = str.repeat("ab", 3, ps(14, ","))
s15 = array.lastindexof(srt, pf(15, 1.0))
s16 = array.binary_search(srt, pf(16, 2.0))
s17 = array.binary_search_leftmost(srt, pf(17, 2.0))
s18 = array.binary_search_rightmost(srt, pf(18, 2.0))
s19 = array.join(astr, ps(19, ","))
array.concat(a3, pa(20))
s21 = array.lastindexof(astr, ps(21, "a"))
s22 = close < 0 and pb(22, close > open)
s23 = close < 0 ? pf(23, close) : 1.0
s24 = color.from_gradient(pf(24, close), 0, 5000, color.red, color.green)
s25 = str.contains(ps(25, "abc"), "b")
s26 = str.substring(ps(26, "abcdef"), 1, 3)

d(int k) => str.tostring(array.get(cnt, k) - (bar_index + 1))
if hour(time, "UTC") % 6 == 0 and minute(time, "UTC") == 0
    strategy.entry("L", strategy.long, comment = "E")
if hour(time, "UTC") % 6 == 0 and minute(time, "UTC") == 15
    strategy.close("L", comment = d(1) + "|" + d(2) + "|" + d(3) + "|" + d(4) + "|" + d(5) + "|" + d(6) + "|" + d(7) + "|" + d(8) + "|" + d(9) + "|" + d(10) + "|" + d(11) + "|" + d(12) + "|" + d(13) + "|" + d(14) + "|" + d(15) + "|" + d(16) + "|" + d(17) + "|" + d(18) + "|" + d(19) + "|" + d(20) + "|" + d(21) + "|" + d(22) + "|" + d(23) + "|" + d(24) + "|" + d(25) + "|" + d(26) + "|" + s14 + "|" + str.tostring(array.size(a3)))
