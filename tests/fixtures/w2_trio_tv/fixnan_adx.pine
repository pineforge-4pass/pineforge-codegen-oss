//@version=6
strategy("pf-w2-fixnan-adx", overlay = false)

// TradingView's DMI/ADX helpers: fixnan() over a stateful ta.rma inside a
// user function. Every exit comment spells ADX, +DI and -DI (6 decimals), then
// a top-level fixnan() over a stateful call whose argument is na on every
// :30 bar: its value on the exit bar and on the bar before.
dirmov(len) =>
    up = ta.change(high)
    down = -ta.change(low)
    plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    truerange = ta.rma(ta.tr, len)
    plus = fixnan(100 * ta.rma(plusDM, len) / truerange)
    minus = fixnan(100 * ta.rma(minusDM, len) / truerange)
    [plus, minus]
adx(dilen, adxlen) =>
    [plus, minus] = dirmov(dilen)
    sum = plus + minus
    100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), adxlen)

[diPlus, diMinus] = dirmov(14)
sig = adx(14, 14)
held = fixnan(ta.rma(close, 5) * (minute(time, "UTC") == 30 ? na : 1.0))

f(x) => str.tostring(x, "#.######")
if hour(time, "UTC") % 4 == 0 and minute(time, "UTC") == 0
    strategy.entry("L", strategy.long, comment = "E")
if hour(time, "UTC") % 4 == 0 and minute(time, "UTC") == 45
    strategy.close("L", comment = f(sig) + "|" + f(diPlus) + "|" + f(diMinus) + "|" + f(held) + "|" + f(held[1]))
