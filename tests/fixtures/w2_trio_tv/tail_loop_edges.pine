//@version=6
strategy("pf-w2-f04-loop-edges", overlay = true)

// Functions ending in a loop that breaks, continues, never runs, or iterates
// an array.
fBreak(float v) =>
    float s = 0.0
    for i = 1 to 5
        if i == 3
            break
        s := s + v * i
fContinue(float v) =>
    float s = 0.0
    for i = 1 to 3
        if i == 3
            continue
        s := s + v * i
fZero(float v) =>
    float s = 7.0
    int i = 5
    while i < 3
        i += 1
        s := s + v
fForIn(float v) =>
    float s = 0.0
    for x in array.from(1.0, 2.0, 3.0)
        s := s + v * x

f(x) => str.tostring(x, "#.####")
r1 = fBreak(close)
r2 = fContinue(close)
r3 = fZero(close)
r4 = fForIn(close)
if hour(time, "UTC") % 6 == 0 and minute(time, "UTC") == 0
    strategy.entry("L", strategy.long, comment = "E")
if hour(time, "UTC") % 6 == 0 and minute(time, "UTC") == 15
    strategy.close("L", comment = f(r1) + "|" + f(r2) + "|" + f(r3) + "|" + f(r4) + "|" + f(close))
