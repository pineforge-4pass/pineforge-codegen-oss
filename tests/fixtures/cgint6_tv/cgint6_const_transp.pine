//@version=6
// CGINT6 diagnostic: color.t of a color whose fractional transparency is a
// constant, a var, an input, a series and an array element. Each close's
// comment spells the reads.
strategy("CGINT6 const transparency", overlay = true, default_qty_type = strategy.fixed, default_qty_value = 1)
d0 = color.t(color.new(color.red, 10.5))
d1 = color.t(color.new(color.red, transp = 10.5))
var color vc = color.new(color.red, 10.5)
d2 = color.t(vc)
arr = array.from(color.new(color.red, 10.5))
d3 = color.t(array.get(arr, 0))
var arrv = array.from(color.new(color.red, 10.5))
d4 = color.t(array.get(arrv, 0))
float tf = 10.5
d5 = color.t(color.new(color.red, tf))
ti = input.float(10.5)
d6 = color.t(color.new(color.red, ti))
d7 = color.t(color.new(color.red, 20.5))
d8 = color.t(color.new(color.red, 10.4))
d9 = color.t(color.new(color.red, 10.6))
d10 = color.t(color.new(color.red, 0.5))
d11 = color.t(color.new(color.red, 99.5))
d12 = color.t(color.new(color.red, 50.5))
d13 = color.t(color.new(color.red, close > 0 ? 10.5 : 0))
d14 = color.t(color.rgb(1, 2, 3, 10.5))
c0 = color.new(color.red, 10.5)
d15 = color.t(c0)
d16 = color.t(color.new(color.red, 10.5 + bar_index * 0))
s(x) => str.tostring(x)
m = minute(time, "UTC")
if m == 0 or m == 30
    strategy.entry("L", strategy.long)
if m == 15 or m == 45
    strategy.close("L", comment = s(d0) + "|" + s(d1) + "|" + s(d2) + "|" + s(d3) + "|" + s(d4) + "|" + s(d5) + "|" + s(d6) + "|" + s(d7) + "|" + s(d8) + "|" + s(d9) + "|" + s(d10) + "|" + s(d11) + "|" + s(d12) + "|" + s(d13) + "|" + s(d14) + "|" + s(d15) + "|" + s(d16))
