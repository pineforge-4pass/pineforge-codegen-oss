{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022"],
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true
  },
  "include": ["functions/**/*.ts", "server/**/*.ts", "lib/**/*.ts", "content/**/*.ts"],
  "exclude": ["node_modules", "out"]
}
